# HeadHunter API Credentials
# Get your credentials at: https://dev.hh.ru/admin

HH_CLIENT_ID=your_client_id_here
HH_CLIENT_SECRET=your_client_secret_here
HH_APP_TOKEN=your_app_token_here
HH_REDIRECT_URI=https://your-domain.com/oauth/callback

# OAuth tokens are stored in the system credential store by oauth_flow.py.
# Development-only process environment fallback. Never put real tokens here.
HH_ALLOW_ENV_TOKENS=false

# Write operations are disabled unless explicitly enabled.
HH_ENABLE_APPLICATIONS=false
